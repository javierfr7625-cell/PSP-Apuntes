      <div class="tab-content active">
        <pre><code>package ejercicio3;

import java.util.concurrent.Semaphore;

public class HiloPalabras extends Thread &#123;
    // Variables globales requeridas por el enunciado
    public static int menos5 = 0;
    // En Java un identificador no puede empezar con un número, por lo que se define _5omas
    public static int _5omas = 0;

    // SEMÁFOROS INDEPENDIENTES:
    // Permiten que el hilo '2' o '4' acceda a menos5 mientras el hilo '6' u '8' accede a _5omas
    public static Semaphore semMenos5 = new Semaphore(1);
    public static Semaphore sem5omas = new Semaphore(1);

    private String frase;

    public HiloPalabras(String nombre, String frase) &#123;
        super(nombre);
        this.frase = frase;
        start();
    &#125;

    @Override
    public void run() &#123;
        // Dividimos la frase en palabras separadas por espacios
        String[] palabras = frase.trim().split("\\s+");

        for (String p : palabras) &#123;
            // Limpiar signos de puntuación para medir solo caracteres de letras
            String palabraLimpia = p.replaceAll("[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ]", "");
            int longitud = palabraLimpia.length();
            if (longitud == 0) continue;

            boolean haContado = false;

            switch (getName()) &#123;
                case "2" -&gt; &#123;
                    if (longitud &lt;= 2) &#123;
                        haContado = true;
                        try &#123;
                            semMenos5.acquire();
                            menos5++;
                        &#125; catch (InterruptedException e) &#123;
                            Thread.currentThread().interrupt();
                        &#125; finally &#123;
                            semMenos5.release();
                        &#125;
                    &#125;
                &#125;
                case "4" -&gt; &#123;
                    if (longitud &gt;= 3 && longitud &lt;= 4) &#123;
                        haContado = true;
                        try &#123;
                            semMenos5.acquire();
                            menos5++;
                        &#125; catch (InterruptedException e) &#123;
                            Thread.currentThread().interrupt();
                        &#125; finally &#123;
                            semMenos5.release();
                        &#125;
                    &#125;
                &#125;
                case "6" -&gt; &#123;
                    if (longitud &gt;= 5 && longitud &lt;= 6) &#123;
                        haContado = true;
                        try &#123;
                            sem5omas.acquire();
                            _5omas++;
                        &#125; catch (InterruptedException e) &#123;
                            Thread.currentThread().interrupt();
                        &#125; finally &#123;
                            sem5omas.release();
                        &#125;
                    &#125;
                &#125;
                case "8" -&gt; &#123;
                    if (longitud &gt; 6) &#123;
                        haContado = true;
                        try &#123;
                            sem5omas.acquire();
                            _5omas++;
                        &#125; catch (InterruptedException e) &#123;
                            Thread.currentThread().interrupt();
                        &#125; finally &#123;
                            sem5omas.release();
                        &#125;
                    &#125;
                &#125;
            &#125;

            // Cada hilo deberá parar 5ms después de contar cada palabra
            if (haContado) &#123;
                try &#123;
                    Thread.sleep(5);
                &#125; catch (InterruptedException e) &#123;
                    Thread.currentThread().interrupt();
                &#125;
            &#125;
        &#125;
    &#125;
&#125;</code></pre>

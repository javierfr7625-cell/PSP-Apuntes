      <div class="tab-content active">
        <pre><code>package ejercicio2;

import java.util.concurrent.Semaphore;

public class Hilo extends Thread &#123;
    // REGLA CLAVE: El semáforo DEBE ser static para que sea compartido por los 10 hilos
    public static Semaphore semaphore = new Semaphore(1);
    
    // Variable global acumuladora
    public static int numeros = 0;

    private String frase;

    public Hilo(String digito, String frase) &#123;
        super(digito); // Asigna el dígito como nombre del hilo ("0", "1", ..., "9")
        this.frase = frase;
        start(); // Autoarranque del hilo
    &#125;

    @Override
    public void run() &#123;
        int contadorLocal = 0; // Variable local de este hilo
        char[] letras = frase.toCharArray();

        for (char letra : letras) &#123;
            // Si el carácter coincide con el dígito asignado a este hilo
            if (String.valueOf(letra).equals(getName())) &#123;
                try &#123;
                    // Sección Crítica: modificar variable global compartida
                    semaphore.acquire();
                    numeros++;
                &#125; catch (InterruptedException e) &#123;
                    Thread.currentThread().interrupt();
                &#125; finally &#123;
                    semaphore.release();
                &#125;
                contadorLocal++;
            &#125;
        &#125;

        // Cada hilo imprime su recuento local al terminar
        System.out.println("El número " + getName() + " ha aparecido " + contadorLocal + " veces");
    &#125;
&#125;</code></pre>
